{
  "id": "q-051",
  "slug": "rotate-image",
  "title": "Rotate Image",
  "difficulty": "medium",
  "tags": ["blind-75", "matrix", "array", "math"],
  "description": "You are given an `n x n` matrix representing an image. Rotate the image by **90 degrees clockwise**, **in place**: modify the given matrix directly and do not allocate another 2D matrix.\n\nThe function returns nothing: the test checks the matrix you modified.",
  "examples": [
    {
      "input": "matrix = [[1,2,3],[4,5,6],[7,8,9]]",
      "output": "[[7,4,1],[8,5,2],[9,6,3]]"
    },
    {
      "input": "matrix = [[1,2],[3,4]]",
      "output": "[[3,1],[4,2]]"
    }
  ],
  "constraints": [
    "n == matrix.length == matrix[i].length",
    "1 <= n <= 20",
    "-1000 <= matrix[i][j] <= 1000"
  ],
  "hints": [
    "A clockwise rotation equals transposing the matrix and then reversing each row.",
    "Alternatively rotate four cells at a time, working ring by ring."
  ],
  "signature": {
    "params": ["json"],
    "returns": "inplace",
    "inplaceArg": 0
  },
  "testCases": [
    {
      "input": [
        [
          [1, 2, 3],
          [4, 5, 6],
          [7, 8, 9]
        ]
      ],
      "expected": [
        [7, 4, 1],
        [8, 5, 2],
        [9, 6, 3]
      ]
    },
    {
      "input": [
        [
          [5, 1, 9, 11],
          [2, 4, 8, 10],
          [13, 3, 6, 7],
          [15, 14, 12, 16]
        ]
      ],
      "expected": [
        [15, 13, 2, 5],
        [14, 3, 4, 1],
        [12, 6, 8, 9],
        [16, 7, 10, 11]
      ]
    },
    {
      "input": [[[1]]],
      "expected": [[1]],
      "hidden": true
    },
    {
      "input": [
        [
          [1, 2],
          [3, 4]
        ]
      ],
      "expected": [
        [3, 1],
        [4, 2]
      ],
      "hidden": true
    },
    {
      "input": [
        [
          [0, 0],
          [0, 0]
        ]
      ],
      "expected": [
        [0, 0],
        [0, 0]
      ],
      "hidden": true
    },
    {
      "input": [
        [
          [-1, 2],
          [3, -4]
        ]
      ],
      "expected": [
        [3, -1],
        [-4, 2]
      ],
      "hidden": true
    }
  ],
  "languages": {
    "typescript": {
      "starterCode": "function rotate(matrix: number[][]): void {\n  \n}\n",
      "functionName": "rotate",
      "solution": "function rotate(matrix: number[][]): void {\n  const n = matrix.length\n  for (let r = 0; r < n; r++) {\n    for (let c = r + 1; c < n; c++) {\n      ;[matrix[r][c], matrix[c][r]] = [matrix[c][r], matrix[r][c]]\n    }\n  }\n  for (const row of matrix) row.reverse()\n}\n"
    }
  }
}
